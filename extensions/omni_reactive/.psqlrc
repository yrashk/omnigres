create extension omni_reactive cascade;

create table users (
                       id serial primary key,
                       name text not null
);

create table currencies (
                            id serial primary key,
                            code text not null unique
);

create table accounts (
                          user_id int not null,
                          currency_id int not null,
                          primary key (user_id, currency_id),
                          foreign key (user_id) references users(id),
                          foreign key (currency_id) references currencies(id)
);

insert into omni_reactive.reactive_queries (relations, query)
values (array['users','currencies','accounts']::regclass[],
$$
with missing_accounts as materialized (
    select u.id as user_id,
           c.id as currency_id
    from users u
    join currencies c
      on true
    where not exists (
        select 1
        from accounts a
        where a.user_id = u.id
          and a.currency_id = c.id
    )
)
insert into accounts (user_id, currency_id)
select user_id, currency_id
from missing_accounts
    $$);


