create extension omni_httpd cascade;
create extension omni_livehtml;
create extension omni_datasets;
select omni_datasets.instantiate_northwind('public');

create table my_router
(
    like omni_httpd.urlpattern_router
);

create or replace procedure template_handler(request omni_httpd.http_request, out outcome omni_httpd.http_outcome)
    language plpgsql
as
$$
begin
    select
        omni_httpd.http_response(omni_livehtml.html_document_text(omni_livehtml.render(
                $tpl$
                <html>
	<head><meta charset="utf-8"></head>
                <body>
    <omni-query id="customers"><script>
select customers.*, count(orders.*) orders
from
    customers
    natural left join orders
    group by customer_id
    order by country, company_name</script></omni-query>

        <omni-for query="customers">
          <template>
            <h1><omni-slot name="company_name"></omni-slot> (<omni-slot name="country"></omni-slot>)</h1>
            <hr />
            <p><omni-slot name="orders"></omni-slot> order(s)</p>
            <p>Contact: <omni-slot name="contact_name"></p>
          </template>
        </omni-for>
        </body>
        </html>
        $tpl$)), headers => array [omni_http.http_header('content-type', 'text/html')])
    into outcome;
end;
$$;

insert
into
    my_router (match, handler)
values
    (omni_httpd.urlpattern('/'), 'template_handler'::regproc);
